
/* Uses the validated dense-view/storage helpers in shading.c. */
#include "principled_material_scalar.h"
static gffx_status pp_workspace(int grouped,int64_t p,int64_t q,uint32_t derivatives,const gffx_execution_context *c,uint64_t *bytes,uint64_t *alignment,gffx_diagnostic_buffer *d){
 const gffx_cuda_operations *ops;int64_t shape[3];gffx_status s=pc_context(c,d);if(s!=GFFX_STATUS_OK)return s;
 if(derivatives>1||p<0||p>(grouped?128:(derivatives?4:8))||q<0||q>1024||p*q>1024||!bytes||!alignment)return pc_fail(d,"Principled point/light limits invalid");
 if(c->device_type==GFFX_DEVICE_CUDA){ops=gffx_cuda_loader_operations();if(grouped==2&&!GFFX_CUDA_HAS_OPERATION(ops,shading_principled_shared_groups))return gffx_internal_fail(d,GFFX_STATUS_UNSUPPORTED,"CUDA provider lacks shared Principled groups");if((grouped?(!GFFX_CUDA_HAS_OPERATION(ops,shading_principled_groups)||!GFFX_CUDA_HAS_OPERATION(ops,shading_principled_groups_backward)):(!GFFX_CUDA_HAS_OPERATION(ops,shading_principled_pairs)||!GFFX_CUDA_HAS_OPERATION(ops,shading_principled_pairs_backward)))||!ops->workspace_query)return gffx_internal_fail(d,GFFX_STATUS_UNSUPPORTED,"CUDA provider lacks Principled pairs");shape[0]=p;shape[1]=q;shape[2]=derivatives;return ops->workspace_query(grouped?GFFX_CUDA_OP_SHADING_PRINCIPLED_GROUPS:GFFX_CUDA_OP_SHADING_PRINCIPLED,shape,3,GFFX_DTYPE_FLOAT64,c,bytes,alignment,d);}
 *bytes=8+8*(uint64_t)p*(uint64_t)(q>0?q:1);*alignment=8;return GFFX_STATUS_OK;
}
static gffx_status pp_forward(int grouped,const gffx_tensor_view *cn,const gffx_tensor_view *logs,const gffx_tensor_view *curve,const gffx_tensor_view *partial,const gffx_tensor_view *mean,const gffx_tensor_view *width,const gffx_tensor_view *normal,const gffx_tensor_view *view,const gffx_tensor_view *light,const gffx_tensor_view *albedo,const gffx_tensor_view *roughness,const gffx_tensor_view *f0,uint32_t options,const gffx_execution_context *c,gffx_tensor_view *value,gffx_tensor_view *jacobian,const gffx_buffer *w,gffx_diagnostic_buffer *d){
 const gffx_tensor_view *views[14]={cn,logs,curve,partial,mean,width,normal,view,light,albedo,roughness,f0,value,jacobian};const double *ptr[12];uint32_t ranks[12]={1,1,2,2,2,1,2,2,3,2,1,2};int64_t shapes[12][3],counts[12],shape[4],p,q,n,size,i,j,k,curve_rows;uint64_t bytes,alignment;double *y,*jac;gffx_status s=pc_context(c,d);if(s!=GFFX_STATUS_OK)return s;
 if(options>3)return pc_fail(d,"Principled options invalid");for(i=0;i<14;++i){s=gffx_validate_tensor_view(views[i],d);if(s!=GFFX_STATUS_OK)return s;}
 if(cn->rank!=1||normal->rank!=2||light->rank!=3)return pc_fail(d,"Principled extent ranks invalid");n=cn->shape[0];p=normal->shape[0];q=light->shape[1];if(n<1||n>512)return pc_fail(d,"Principled node count invalid");size=10*n-6;curve_rows=grouped==2?1:p;
 s=pp_workspace(grouped,p,q,(options>>1)&1,c,&bytes,&alignment,d);if(s!=GFFX_STATUS_OK)return s;
 for(i=0;i<12;++i){shapes[i][0]=p;shapes[i][1]=3;shapes[i][2]=3;}
 shapes[0][0]=shapes[1][0]=n;shapes[2][1]=shapes[3][1]=size;shapes[4][1]=4;shapes[8][1]=q;for(i=2;i<=5;++i)shapes[i][0]=curve_rows;
 for(i=0;i<12;++i){s=pc_view(views[i],ranks[i],shapes[i],0,c,d);if(s!=GFFX_STATUS_OK)return s;counts[i]=1;for(j=0;j<ranks[i];++j)counts[i]*=shapes[i][j];}
 shape[0]=p;shape[1]=q;shape[2]=3;shape[3]=16;s=pc_view(value,3,shape,1,c,d);if(s!=GFFX_STATUS_OK)return s;
 if(options&2)s=pc_view(jacobian,4,shape,1,c,d);else{shape[0]=0;s=pc_view(jacobian,1,shape,1,c,d);}if(s!=GFFX_STATUS_OK)return s;
 s=pc_storage(views,14,2,w,bytes,c,d);if(s!=GFFX_STATUS_OK)return s;
 if(c->device_type==GFFX_DEVICE_CUDA)return (grouped==2?gffx_cuda_loader_operations()->shading_principled_shared_groups:(grouped?gffx_cuda_loader_operations()->shading_principled_groups:gffx_cuda_loader_operations()->shading_principled_pairs))(cn,logs,curve,partial,mean,width,normal,view,light,albedo,roughness,f0,options,c,value,jacobian,w,d);
 for(i=0;i<12;++i){ptr[i]=gffx_mesh_elements_const(views[i]);for(j=0;j<counts[i];++j)if(!isfinite(ptr[i][j]))return pc_fail(d,"Principled finite inputs required");}
 for(i=0;i<n;++i)if(ptr[0][i]<=0.||ptr[0][i]>1.||ptr[1][i]>0.||(i&&(ptr[0][i]<=ptr[0][i-1]||ptr[1][i]<=ptr[1][i-1]||!isfinite(ptr[1][i]-ptr[1][i-1]))))return pc_fail(d,"Principled axes domain");if(ptr[0][n-1]!=1.)return pc_fail(d,"Principled cosine axis endpoint");
 for(i=0;i<curve_rows;++i)if(ptr[5][i]<=0.||ptr[4][4*i]<=0.||ptr[4][4*i]>1.||ptr[4][4*i+1]<=0.||ptr[4][4*i+1]>ptr[4][4*i])return pc_fail(d,"Principled width/mean domain");
 for(i=0;i<p;++i){if(ptr[10][i]<=0.||ptr[10][i]>1.)return pc_fail(d,"Principled roughness domain");
  if((ptr[6][3*i]==0.&&ptr[6][3*i+1]==0.&&ptr[6][3*i+2]==0.)||(ptr[7][3*i]==0.&&ptr[7][3*i+1]==0.&&ptr[7][3*i+2]==0.))return pc_fail(d,"Principled zero point direction");}
 for(i=0;i<p*q;++i)if(ptr[8][3*i]==0.&&ptr[8][3*i+1]==0.&&ptr[8][3*i+2]==0.)return pc_fail(d,"Principled zero light direction");
 for(i=0;i<p*3;++i)if(ptr[9][i]<0.||ptr[9][i]>1.||ptr[11][i]<0.||ptr[11][i]>1.)return pc_fail(d,"Principled albedo/F0 domain");
 for(i=0;i<curve_rows*size;i+=2)if(ptr[2][i]<ptr[2][i+1]||ptr[2][i]>1.||ptr[2][i+1]<0.)return pc_fail(d,"Principled curve domain");
 y=gffx_mesh_elements(value);jac=gffx_mesh_elements(jacobian);
 for(i=0;i<p;++i)for(j=0;j<q;++j){double input[16],out[51];int fail;int64_t ci=grouped==2?0:i;gffx_pp_pack((int)i,(int)(i*q+j),ptr[6],ptr[7],ptr[8],ptr[9],ptr[10],ptr[11],input);
  fail=(options&2)?gffx_pm_point((int)n,ptr[0],ptr[1],ptr[2]+ci*size,ptr[3]+ci*size,ptr[4]+4*ci,ptr[5][ci],input,options&1,out):gffx_pv_point((int)n,ptr[0],ptr[1],ptr[2]+ci*size,ptr[3]+ci*size,ptr[4]+4*ci,ptr[5][ci],input,options&1,out);
  if(fail)return gffx_internal_fail(d,GFFX_STATUS_OVERFLOW,"Principled arithmetic overflow");for(k=0;k<3;++k)y[3*(i*q+j)+k]=out[k];if(options&2)for(k=0;k<48;++k)jac[48*(i*q+j)+k]=out[3+k];}
 return GFFX_STATUS_OK;
}
static gffx_status pp_backward(int grouped,const gffx_tensor_view *jacobian,const gffx_tensor_view *gradient,const gffx_execution_context *c,gffx_tensor_view *point_gradient,gffx_tensor_view *light_gradient,const gffx_buffer *w,gffx_diagnostic_buffer *d){
 const gffx_tensor_view *views[4]={jacobian,gradient,point_gradient,light_gradient};const double *jac,*g;double *pg,*lg,*scratch;int64_t p,q,i,k,shape[4];uint64_t bytes,alignment;gffx_status s=pc_context(c,d);if(s!=GFFX_STATUS_OK)return s;
 s=gffx_validate_tensor_view(jacobian,d);if(s!=GFFX_STATUS_OK)return s;if(jacobian->rank!=4)return pc_fail(d,"Principled Jacobian rank invalid");p=jacobian->shape[0];q=jacobian->shape[1];s=pp_workspace(grouped,p,q,1,c,&bytes,&alignment,d);if(s!=GFFX_STATUS_OK)return s;
 shape[0]=p;shape[1]=q;shape[2]=3;shape[3]=16;s=pc_view(jacobian,4,shape,0,c,d);if(s!=GFFX_STATUS_OK)return s;s=pc_view(gradient,3,shape,0,c,d);if(s!=GFFX_STATUS_OK)return s;s=pc_view(light_gradient,3,shape,1,c,d);if(s!=GFFX_STATUS_OK)return s;shape[1]=16;s=pc_view(point_gradient,2,shape,1,c,d);if(s!=GFFX_STATUS_OK)return s;s=pc_storage(views,4,2,w,bytes,c,d);if(s!=GFFX_STATUS_OK)return s;
 if(c->device_type==GFFX_DEVICE_CUDA)return (grouped?gffx_cuda_loader_operations()->shading_principled_groups_backward:gffx_cuda_loader_operations()->shading_principled_pairs_backward)(jacobian,gradient,c,point_gradient,light_gradient,w,d);
 jac=gffx_mesh_elements_const(jacobian);g=gffx_mesh_elements_const(gradient);pg=gffx_mesh_elements(point_gradient);lg=gffx_mesh_elements(light_gradient);scratch=(double *)w->data+1;
 for(i=0;i<p*q*48;++i)if(!isfinite(jac[i]))return pc_fail(d,"Principled Jacobian must be finite");for(i=0;i<p*q*3;++i)if(!isfinite(g[i]))return pc_fail(d,"Principled cotangent must be finite");
 for(i=0;i<p;++i)gffx_pp_contract((int)q,jac+i*q*48,g+i*q*3,pg+16*i,scratch);
 for(i=0;i<p*q;++i)for(k=0;k<3;++k)lg[3*i+k]=gffx_pp_rgb(jac+48*i,g+3*i,(int)k+6);
 for(i=0;i<p*16;++i)if(!isfinite(pg[i]))return gffx_internal_fail(d,GFFX_STATUS_OVERFLOW,"Principled point VJP overflow");for(i=0;i<p*q*3;++i)if(!isfinite(lg[i]))return gffx_internal_fail(d,GFFX_STATUS_OVERFLOW,"Principled light VJP overflow");return GFFX_STATUS_OK;
}

/* Separate entry points preserve the original public/raw pairs limits. */
GFFX_API gffx_status GFFX_CALL gffx_shading_principled_pairs_workspace(int64_t p,int64_t q,uint32_t derivatives,const gffx_execution_context *c,uint64_t *bytes,uint64_t *alignment,gffx_diagnostic_buffer *d){return pp_workspace(0,p,q,derivatives,c,bytes,alignment,d);}
GFFX_API gffx_status GFFX_CALL gffx_shading_principled_groups_workspace(int64_t p,int64_t q,uint32_t derivatives,const gffx_execution_context *c,uint64_t *bytes,uint64_t *alignment,gffx_diagnostic_buffer *d){return pp_workspace(1,p,q,derivatives,c,bytes,alignment,d);}
GFFX_API gffx_status GFFX_CALL gffx_shading_principled_pairs(const gffx_tensor_view *cn,const gffx_tensor_view *logs,const gffx_tensor_view *curve,const gffx_tensor_view *partial,const gffx_tensor_view *mean,const gffx_tensor_view *width,const gffx_tensor_view *normal,const gffx_tensor_view *view,const gffx_tensor_view *light,const gffx_tensor_view *albedo,const gffx_tensor_view *roughness,const gffx_tensor_view *f0,uint32_t options,const gffx_execution_context *c,gffx_tensor_view *value,gffx_tensor_view *jacobian,const gffx_buffer *w,gffx_diagnostic_buffer *d){return pp_forward(0,cn,logs,curve,partial,mean,width,normal,view,light,albedo,roughness,f0,options,c,value,jacobian,w,d);}
GFFX_API gffx_status GFFX_CALL gffx_shading_principled_groups(const gffx_tensor_view *cn,const gffx_tensor_view *logs,const gffx_tensor_view *curve,const gffx_tensor_view *partial,const gffx_tensor_view *mean,const gffx_tensor_view *width,const gffx_tensor_view *normal,const gffx_tensor_view *view,const gffx_tensor_view *light,const gffx_tensor_view *albedo,const gffx_tensor_view *roughness,const gffx_tensor_view *f0,uint32_t options,const gffx_execution_context *c,gffx_tensor_view *value,gffx_tensor_view *jacobian,const gffx_buffer *w,gffx_diagnostic_buffer *d){return pp_forward(1,cn,logs,curve,partial,mean,width,normal,view,light,albedo,roughness,f0,options,c,value,jacobian,w,d);}
GFFX_API gffx_status GFFX_CALL gffx_shading_principled_pairs_backward(const gffx_tensor_view *jacobian,const gffx_tensor_view *gradient,const gffx_execution_context *c,gffx_tensor_view *point_gradient,gffx_tensor_view *light_gradient,const gffx_buffer *w,gffx_diagnostic_buffer *d){return pp_backward(0,jacobian,gradient,c,point_gradient,light_gradient,w,d);}
GFFX_API gffx_status GFFX_CALL gffx_shading_principled_groups_backward(const gffx_tensor_view *jacobian,const gffx_tensor_view *gradient,const gffx_execution_context *c,gffx_tensor_view *point_gradient,gffx_tensor_view *light_gradient,const gffx_buffer *w,gffx_diagnostic_buffer *d){return pp_backward(1,jacobian,gradient,c,point_gradient,light_gradient,w,d);}

GFFX_API gffx_status GFFX_CALL gffx_shading_principled_shared_groups(const gffx_tensor_view *cn,const gffx_tensor_view *logs,const gffx_tensor_view *curve,const gffx_tensor_view *partial,const gffx_tensor_view *mean,const gffx_tensor_view *width,const gffx_tensor_view *normal,const gffx_tensor_view *view,const gffx_tensor_view *light,const gffx_tensor_view *albedo,const gffx_tensor_view *roughness,const gffx_tensor_view *f0,uint32_t options,const gffx_execution_context *c,gffx_tensor_view *value,gffx_tensor_view *jacobian,const gffx_buffer *w,gffx_diagnostic_buffer *d){return pp_forward(2,cn,logs,curve,partial,mean,width,normal,view,light,albedo,roughness,f0,options,c,value,jacobian,w,d);}
